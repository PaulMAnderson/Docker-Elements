ARG ROOT_IMAGE=mathworks/matlab:r2025b
FROM $ROOT_IMAGE

# Fix: https://github.com/hadolint/hadolint/wiki/DL4006
# Fix: https://github.com/koalaman/shellcheck/wiki/SC3014
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV USER="matlab"
ENV UID=99
ENV GID=100
ENV GROUP="users"

USER root

# Change the user and group ids 
RUN usermod -u ${UID} -g ${GID} ${USER} && \
    groupmod -g ${GID} users || true && \
    usermod -aG users ${USER} && \
    chown -R ${UID}:${GID} /home/${USER}

## Install extra toolboxes
ARG ADDITIONAL_PRODUCTS="Statistics_and_Machine_Learning_Toolbox Signal_Processing_Toolbox Curve_Fitting_Toolbox Optimization_Toolbox Global_Optimization_Toolbox Image_Processing_Toolbox"
ARG MATLAB_RELEASE=R2025b

# Install mpm dependencies
RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install --no-install-recommends --yes \
        wget \
        ca-certificates \
    && apt-get clean \
    && apt-get autoremove \
    && rm -rf /var/lib/apt/lists/*

# Run mpm to install MathWorks products
WORKDIR /tmp
USER matlab
RUN wget -q https://www.mathworks.com/mpm/glnxa64/mpm \
    && chmod +x mpm \
    && EXISTING_MATLAB_LOCATION=$(dirname $(dirname $(readlink -f $(which matlab)))) \
    && sudo HOME=${HOME} ./mpm install \
        --destination=${EXISTING_MATLAB_LOCATION} \
        --release=${MATLAB_RELEASE} \
        --products ${ADDITIONAL_PRODUCTS} \
    || (echo "MPM Installation Failure. See below for more information:" && cat /tmp/mathworks_root.log && false) \
    && sudo rm -rf mpm /tmp/mathworks_root.log

## OS Dependencies, Node.js (v22), and GCloud CLI
USER root
ENV DEBIAN_FRONTEND=noninteractive

# Consolidated APT Installation
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
    | tee -a /etc/apt/sources.list.d/google-cloud-sdk.list && \
    curl https://packages.cloud.google.com/apt/doc/apt-key.gpg \
    | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg && \
    wget -O /usr/share/keyrings/gpg-pub-moritzbunkus.gpg https://mkvtoolnix.download/gpg-pub-moritzbunkus.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/gpg-pub-moritzbunkus.gpg] https://mkvtoolnix.download/ubuntu/ jammy main" \
    | tee /etc/apt/sources.list.d/mkvtoolnix.list && \
    apt-get update --yes && \
    apt-get upgrade --yes && \
    apt-get install --yes --no-install-recommends \
    bzip2 \
    ca-certificates \
    locales \
    netbase \
    sudo \
    tini \
    fish \
    curl \
    rsync \
    vim \
    zip \
    unzip \
    git \
    wget \
    apt-utils \
    build-essential \
    gnupg \
    apt-transport-https \
    cm-super \
    dvipng \
    ffmpeg \
    mkvtoolnix \
    fonts-liberation \
    pandoc \
    run-one \
    supervisor \
    gosu \
    nodejs \
    openssh-server \
    google-cloud-cli && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    echo "en_US.UTF-8 UTF-8" > /etc/locale.gen && \
    echo "C.UTF-8 UTF-8" >> /etc/locale.gen && \
    mkdir -p /var/run/sshd /var/log/supervisor && \
    locale-gen

# Configure environment
ENV CONDA_DIR=/opt/conda \
    SHELL=/bin/bash \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    LANGUAGE=C.UTF-8 \
    PATH="/opt/conda/bin:${PATH}" \
    HOME="/home/${USER}" \
    NPM_CONFIG_PREFIX="/home/matlab/.npm-global"

ENV PATH="${NPM_CONFIG_PREFIX}/bin:${PATH}"

# Scripts and Permissions
COPY fix-permissions /usr/local/bin/fix-permissions
COPY run.sh /usr/local/bin/run.sh
COPY utils.sh /usr/local/bin/utils.sh
COPY entrypoint.sh /usr/local/bin/entrypoint.sh

RUN chmod a+rx /usr/local/bin/fix-permissions && \
    chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/run.sh /usr/local/bin/utils.sh && \
    # Fix line endings
    sed -i 's/\r$//' /usr/local/bin/entrypoint.sh /usr/local/bin/run.sh /usr/local/bin/utils.sh

# Bash/Shell Profile Config
RUN sed -i 's/^#force_color_prompt=yes/force_color_prompt=yes/' /etc/skel/.bashrc && \
    echo 'eval "$(${CONDA_DIR}/bin/conda shell.bash hook)"' >> /etc/skel/.bashrc && \
    mkdir -p "${CONDA_DIR}" && \
    chown "${USER}:${GID}" "${CONDA_DIR}"

# SSH Setup
RUN mkdir -p /var/run/sshd /root/.ssh /etc/ssh && chmod 755 /etc/ssh && \
    echo "PasswordAuthentication no" >> /etc/ssh/sshd_config && \
    echo "PubkeyAuthentication yes" >> /etc/ssh/sshd_config && \
    echo "PermitRootLogin no" >> /etc/ssh/sshd_config && \
    echo "ChallengeResponseAuthentication no" >> /etc/ssh/sshd_config && \
    echo "AuthorizedKeysFile .ssh/authorized_keys" >> /etc/ssh/sshd_config && \
    ssh-keygen -A && \
    chown $USER:$GROUP /etc/ssh/ssh_host*

COPY authorized_keys /home/$USER/.ssh/authorized_keys
RUN mkdir -p /home/$USER/.ssh && \
    chmod 700 /home/$USER/.ssh && \
    chmod 600 /home/$USER/.ssh/authorized_keys && \
    chown -R $USER:$GROUP /home/$USER/.ssh

# Data Mountpoints
RUN mkdir -p "/mnt/data processing" /mnt/data /mnt/code && \
    fix-permissions "/mnt/data processing" /mnt/data /mnt/code

# Python/Micromamba Bootstrap
ARG PYTHON_VERSION=3.12
COPY --chown="${UID}:${GID}" initial-condarc "${CONDA_DIR}/.condarc"
WORKDIR /tmp
RUN set -x && \
    arch=$(uname -m) && [ "${arch}" = "x86_64" ] && arch="64"; \
    wget -qO- "https://micro.mamba.pm/api/micromamba/linux-${arch}/latest" | tar -xvj bin/micromamba && \
    PYTHON_SPECIFIER="python=${PYTHON_VERSION}" && \
    if [[ "${PYTHON_VERSION}" == "default" ]]; then PYTHON_SPECIFIER="python"; fi && \
    ./bin/micromamba install \
        --root-prefix="${CONDA_DIR}" \
        --prefix="${CONDA_DIR}" \
        --yes \
        'jupyter_core' \
        'conda' \
        'mamba' \
        "${PYTHON_SPECIFIER}" && \
    rm -rf /tmp/bin/ && \
    mamba clean --all -f -y && \
    fix-permissions "${CONDA_DIR}"

# Combined Python Environment Install (Jupyter + Data Science + Ephys)
# Note: Moved hdbscan, docker, mtscomp, pydantic to mamba
RUN mamba install --yes \
    'jupyterhub-singleuser' \
    'jupyterlab' \
    'nbclassic' \
    'notebook>=7.2.2' \
    'ipykernel' \
    'altair' \
    'beautifulsoup4' \
    'bokeh' \
    'bottleneck' \
    'cloudpickle' \
    'conda-forge::blas=*=openblas' \
    'cython' \
    'dask' \
    'dill' \
    'h5py' \
    'ipympl' \
    'ipywidgets' \
    'jupyterlab-git' \
    'matplotlib-base' \
    'numba' \
    'numexpr' \
    'openpyxl' \
    'pandas' \
    'patsy' \
    'protobuf' \
    'pytables' \
    'scikit-image' \
    'scikit-learn' \
    'scipy' \
    'seaborn' \
    'sqlalchemy' \
    'statsmodels' \
    'sympy' \
    'widgetsnbextension' \
    'xlrd' \
    'hdbscan' \
    'pydantic' && \
    jupyter server --generate-config && \
    echo "c.PasswordIdentityProvider.hashed_password = 'sha1:41eb0095b22f:18586ae781ed9292674508cdb380469f26a8a1d4'" >> ${HOME}/.jupyter/jupyter_server_config.py && \
    mamba clean --all -f -y && \
    jupyter lab clean && \
    rm -rf "${HOME}/.cache/yarn" && \
    fix-permissions "${CONDA_DIR}" && \
    fix-permissions "${HOME}"

# Shell Customization (Fish)
USER root
RUN chsh -s /usr/bin/fish ${USER}

USER ${UID}
RUN conda init bash && \
    conda init fish && \
    mkdir -p "/home/${USER}/.config/fish" && \
    printf 'set -g fish_greeting ""\nconda activate base\n' >> "/home/${USER}/.config/fish/config.fish"

# Pip Installs (Only for packages not reliably on Conda)
RUN pip install --no-cache-dir \
    neo \
    "spikeinterface[full,widgets]" \
    "spikeinterface-gui[web]" \
    open-ephys-python-tools \
    jupyter-matlab-proxy \
    mountainsort5 \
    docker \
    mtscomp \
    git+https://github.com/PaulMAnderson/Kilosort.git

# DeepLabCut (Special install for CUDA 12.6 compatibility)
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cu126 && \
    pip install --no-cache-dir --pre 'deeplabcut[gui,modelzoo,wandb]==3.0.0rc13'

# Claude Code and Gemini CLI
USER ${UID}
RUN mkdir -p "${NPM_CONFIG_PREFIX}" && \
    curl -fsSL https://claude.ai/install.sh | bash && \
    npm install -g @google/gemini-cli

USER root

# Ports
ENV JUPYTER_PORT=8888
ENV MWI_APP_PORT=8889
ENV SI_GUI_PORT=8890
EXPOSE $JUPYTER_PORT $MWI_APP_PORT $SI_GUI_PORT

# Runtime Configuration
ENV MWI_USE_EXISTING_LICENSE=True
# Placeholder values - pass real values at runtime with -e
ENV GOOGLE_CLOUD_PROJECT=""
ENV GOOGLE_CLOUD_LOCATION=global
ENV DJ_USER=""
ENV DJ_PASS=""

# Supervisor
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf
RUN fix-permissions /etc/supervisor/ && \
    fix-permissions /usr/local/bin/

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD []
